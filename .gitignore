# Build output
/bin/
# go build ./cmd/hangar at the repository root
/hangar
/hangar.exe
/dist/
/coverage.out
/coverage/
*.test
*.prof

# UI build output (embedded at build time; the directory itself is kept)
/internal/web/dist/*
!/internal/web/dist/.gitkeep
/ui/node_modules/
/ui/test-results/
/ui/playwright-report/
/ui/blob-report/
/ui/.vite/
# TypeScript incremental build state (tsc -b)
*.tsbuildinfo

# Python (compat suites)
.venv/
__pycache__/
.pytest_cache/
*.pyc

# Secrets for the Compose examples (docs/get-started/compose.md)
.env

# Local data and fixtures cache
/.cache/
/compat/.fixtures/
/tmp/

# Editors and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
/site/
