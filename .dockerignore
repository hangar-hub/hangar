# Keep the build context small and free of local state.
.git
**/node_modules
ui/test-results
ui/playwright-report
ui/blob-report
internal/web/dist/*
!internal/web/dist/.gitkeep
bin
hangar
hangar.exe
tmp
coverage*
# GoReleaser output, about 400 MB after a snapshot or make release-rehearsal.
dist
compat/.venv
compat/.fixtures
**/__pycache__
docs
site
deploy
loadtest
