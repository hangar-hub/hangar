{
  "title": "Hangar",
  "description": "Hangar: requests, transfers, Pulls, Jobs, storage and security, from the Elastic OpenTelemetry data streams.",
  "panels": [
    {
      "type": "vis",
      "id": "hangar-1",
      "grid": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 12
      },
      "config": {
        "title": "Requests by protocol",
        "type": "xy",
        "axis": {
          "x": {
            "title": {
              "visible": false
            },
            "scale": "temporal",
            "domain": {
              "type": "fit",
              "rounding": false
            }
          },
          "y": {
            "title": {
              "visible": false
            }
          }
        },
        "layers": [
          {
            "type": "line",
            "data_source": {
              "type": "esql",
              "query": "FROM logs-*.otel-* | WHERE service.name == \"hangar\" AND body.text == \"request\" AND protocol != \"health\" | STATS requests = COUNT(*) BY t = BUCKET(@timestamp, 75, ?_tstart, ?_tend), protocol"
            },
            "x": {
              "column": "t",
              "label": "@timestamp"
            },
            "y": [
              {
                "column": "requests"
              }
            ],
            "breakdown_by": {
              "column": "protocol"
            }
          }
        ]
      }
    },
    {
      "type": "vis",
      "id": "hangar-2",
      "grid": {
        "x": 16,
        "y": 0,
        "w": 16,
        "h": 12
      },
      "config": {
        "title": "Request latency, 95th percentile",
        "type": "xy",
        "axis": {
          "x": {
            "title": {
              "visible": false
            },
            "scale": "temporal",
            "domain": {
              "type": "fit",
              "rounding": false
            }
          },
          "y": {
            "title": {
              "visible": false
            }
          }
        },
        "layers": [
          {
            "type": "line",
            "data_source": {
              "type": "esql",
              "query": "FROM logs-*.otel-* | WHERE service.name == \"hangar\" AND body.text == \"request\" AND protocol != \"health\" | STATS p95 = PERCENTILE(duration_ms, 95) / 1000 BY t = BUCKET(@timestamp, 75, ?_tstart, ?_tend), protocol"
            },
            "x": {
              "column": "t",
              "label": "@timestamp"
            },
            "y": [
              {
                "column": "p95"
              }
            ],
            "breakdown_by": {
              "column": "protocol"
            }
          }
        ]
      }
    },
