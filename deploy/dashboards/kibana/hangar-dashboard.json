            "data_source": {
              "type": "esql",
              "query": "FROM logs-*.otel-* | WHERE service.name == \"hangar\" AND body.text == \"request\" AND protocol != \"health\" AND status >= 500 | STATS errors = COUNT(*) BY t = BUCKET(@timestamp, 75, ?_tstart, ?_tend), protocol"
            },
