// The documentation site at https://hangar.page/, a Worker that serves only
// static assets (docs/spec/12-packaging-and-release.md).
// scripts/docs-root-files.sh copies this file to the root of the gh-pages
// branch, and Workers Builds runs `wrangler deploy` there on each push, so the
// Worker serves the branch as mike left it.
{
  "$schema": "https://unpkg.com/wrangler@4.147.0/config-schema.json",
  "name": "hangar-docs",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": ".",
    // A missing page gets the nearest 404.html: the version's own, or the
    // root one for paths outside every version.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "hangar.page", "custom_domain": true },
    // Branch Previews (deploy/cloudflare/docs-preview) at
    // <name>.docs.hangar.page; docs.hangar.page itself serves nothing.
    { "pattern": "docs.hangar.page", "custom_domain": true, "previews_enabled": true, "enabled": false }
  ],
  "observability": { "enabled": false },
  // No workers.dev addresses: Previews use docs.hangar.page.
  "workers_dev": false,
  "preview_urls": false
}
